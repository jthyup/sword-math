rules_version = '2';

// 연산 대장간 Firestore 보안 규칙
// - 학생: 자기 기록(sm_students/{자기 uid})만 읽고 쓸 수 있어요.
// - 선생님(아래 구글 계정): 모든 학생 기록을 보고, 지우고, 출제 범위·가입 허용·랭킹 공개를 바꿀 수 있어요.
// - 랭킹판(sm_rank): 로그인한 학생끼리 별명·최고 강화·주간 문제 수만 볼 수 있어요.
// - 그 밖의 모든 경로는 막혀 있어요.
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 통째로 붙여 넣고 [게시]를 누르세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email == 'donnie05124@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // 선생님이 '학생 스스로 가입'을 끄면 새 기록을 만들 수 없어요.
    function signupOpen() {
      return !exists(/databases/$(database)/documents/sm_settings/class)
        || get(/databases/$(database)/documents/sm_settings/class).data.get('signup', true) == true;
    }

    // 선생님이 '학생에게 랭킹 보이기'를 끄면 학생은 랭킹판을 읽을 수 없어요.
    function rankOpen() {
      return !exists(/databases/$(database)/documents/sm_settings/class)
        || get(/databases/$(database)/documents/sm_settings/class).data.get('ranking', true) == true;
    }

    function validRank() {
      return request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 8
        && request.resource.data.best is int
        && request.resource.data.uid == request.auth.uid;
    }

    // 학년·반·번호: 그대로이거나, 처음 정하거나, 마지막 변경 뒤 7일이 지났을 때만 (변경 시각은 서버 시각)
    function sameClass() {
      return request.resource.data.get('grade', 0) == resource.data.get('grade', 0)
        && request.resource.data.get('cls', 0) == resource.data.get('cls', 0)
        && request.resource.data.get('no', 0) == resource.data.get('no', 0)
        && request.resource.data.get('sid', '') == resource.data.get('sid', '')
        && request.resource.data.get('gch', null) == resource.data.get('gch', null);
    }
    function firstClass() {
      return resource.data.get('no', 0) == 0
        && request.resource.data.get('gch', null) == resource.data.get('gch', null);
    }
    function weeklyClass() {
      return request.resource.data.get('gch', null) == request.time
        && (!(resource.data.get('gch', null) is timestamp)
            || request.time > resource.data.gch + duration.value(7, 'd'));
    }
    function classOK() {
      return sameClass() || firstClass() || weeklyClass();
    }

    // 랭킹 별명: 처음 정할 때와 선생님이 지운 뒤에는 무료, 그 밖에는 변경권 1장을 써야 해요.
    function nickOK() {
      return request.resource.data.get('nick', '') == resource.data.get('nick', '')
        || resource.data.get('nick', '') == ''
        || request.resource.data.get('nickTk', 0) == resource.data.get('nickTk', 0) - 1;
    }
    // 변경권은 3,000골드를 내야만 늘어나요 (최대 1장).
    function nickTkOK() {
      return request.resource.data.get('nickTk', 0) <= resource.data.get('nickTk', 0)
        || (request.resource.data.get('nickTk', 0) == resource.data.get('nickTk', 0) + 1
            && request.resource.data.get('nickTk', 0) <= 1
            && request.resource.data.get('gold', 0) <= resource.data.get('gold', 0) - 3000);
    }

    // 랭킹판에 올리는 별명과 최고 강화는 자기 학생 기록과 같아야 해요.
    function rankMatches() {
      return request.resource.data.nick == get(/databases/$(database)/documents/sm_students/$(request.auth.uid)).data.get('nick', '')
        && request.resource.data.best <= get(/databases/$(database)/documents/sm_students/$(request.auth.uid)).data.get('best', 0);
    }

    function validStudent() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20;
    }

    // 출제 범위, 가입 허용: 누구나 읽고, 선생님만 바꿔요.
    match /sm_settings/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // 학생 기록
    match /sm_students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if isTeacher()
        || (signedIn() && request.auth.uid == uid && signupOpen() && validStudent()
            && request.resource.data.get('care', false) == false
            && request.resource.data.get('range', null) == null
            && request.resource.data.get('gch', null) == null
            && request.resource.data.get('nickTk', 0) == 0);
      // 학생은 자기 기록을 고칠 수 있지만, 선생님이 정한 '기초 지원'·'문제 범위'는 못 바꾸고,
      // 학년·반·번호(일주일 1번), 별명(변경권 필요)도 규칙대로만 바꿀 수 있어요.
      allow update: if isTeacher()
        || (signedIn() && request.auth.uid == uid && validStudent()
            && request.resource.data.get('care', false) == resource.data.get('care', false)
            && request.resource.data.get('range', null) == resource.data.get('range', null)
            && classOK() && nickOK() && nickTkOK());
      allow delete: if isTeacher();
    }

    // 랭킹판: 별명, 최고 강화, 이번 주 맞힌 문제 수만 담아요. (정답률 등은 선생님만)
    match /sm_rank/{uid} {
      allow read: if isTeacher() || (signedIn() && rankOpen());
      allow create, update: if signedIn() && request.auth.uid == uid && validRank() && rankMatches();
      allow delete: if isTeacher() || (signedIn() && request.auth.uid == uid);
    }
  }
}
